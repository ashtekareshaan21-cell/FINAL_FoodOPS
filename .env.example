# Database (SQLite for local dev, or PostgreSQL connection URI for production)
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://user:password@host:5432/db"

# Session signing secret (use a strong 32+ char secret in production)
JWT_SECRET="replace-with-32-char-random-secret"

# Public site URL & optional contact/demo settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_CONTACT_EMAIL="FoodOPServices@gmail.com"
# NEXT_PUBLIC_DEMO_MODE="false"

# Optional external keys
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_KEY_HERE"
# RESEND_API_KEY=""

# Admin Portal Gate (LOCAL DEV ONLY — never set on Vercel/production)
# Requires ADMIN_PORTAL_ENABLED=true + NODE_ENV=development + localhost/127.0.0.1 host.
ADMIN_PORTAL_ENABLED=false
