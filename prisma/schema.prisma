// Prisma schema for FoodOps platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserRole {
  DONOR
  NGO
  VOLUNTEER
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  ACCEPTED
  VOLUNTEER_ASSIGNED
  PICKUP_IN_PROGRESS
  PICKED_UP
  DELIVERY_IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
  RECOVERY_ESCALATED
  ORGANIC_RECOVERY
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum NGOStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum NgoAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  ARRIVED
  COMPLETED
  CANCELLED
}

// ============ USERS & AUTHENTICATION ============

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  phoneNumber       String             @unique
  passwordHash      String?
  role              UserRole           @default(DONOR)
  accountStatus     AccountStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  isPhoneVerified   Boolean            @default(false)
  isEmailVerified   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastLoginAt       DateTime?

  // Relationships
  donor                DonorProfile?
  ngo                  NGOProfile?
  volunteer            Volunteer?
  admin                AdminProfile?
  notifications        Notification[]
  otpAttempts          OTPAttempt[]
  verificationRequests VerificationRequest[]

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@index([verificationStatus])
}

model VerificationRequest {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationType UserRole
  status           VerificationStatus   @default(PENDING_VERIFICATION)
  submittedAt      DateTime             @default(now())
  reviewedAt       DateTime?
  reviewerId       String?
  rejectionReason  String?
  notes            String?
  documents        VerificationDocument[]

  @@index([userId])
  @@index([status])
}

model VerificationDocument {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest  VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  documentType          String
  storagePath           String
  verificationStatus    VerificationStatus  @default(PENDING_VERIFICATION)
  uploadedAt            DateTime            @default(now())
  reviewedAt            DateTime?

  @@index([verificationRequestId])
}

model OTPAttempt {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp               String
  purpose           String
  expiresAt         DateTime
  isUsed            Boolean  @default(false)
  usedAt            DateTime?
  attemptCount      Int      @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  adminLevel        Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DonorProfile {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName        String
  organizationType        String
  contactPerson           String
  address                 String
  city                    String?
  latitude                Float
  longitude               Float
  verificationStatus      VerificationStatus @default(PENDING_VERIFICATION)
  rejectionReason         String?
  verificationSubmittedAt DateTime?
  verificationApprovedAt  DateTime?
  donations               Donation[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([userId])
  @@index([verificationStatus])
}

model NGOProfile {
  id                      String              @id @default(cuid())
  userId                  String              @unique
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName        String              @unique
  registrationNumber      String              @unique
  status                  NGOStatus           @default(PENDING_VERIFICATION)
  baseAddress             String
  city                    String?
  baseLatitude            Float
  baseLongitude           Float
  serviceRadiusKm         Int                 @default(10)
  availability            NgoAvailability     @default(AVAILABLE)
  availabilityUpdatedAt   DateTime            @default(now())
  acceptedFoodTypes       String              @default("")
  contactPerson           String
  contactPhone            String
  verificationDocumentUrl String?
  verificationSubmittedAt DateTime?
  verificationApprovedAt  DateTime?
  verificationRejectedAt  DateTime?
  rejectionReason         String?
  volunteers              Volunteer[]
  acceptedDonations       Donation[]          @relation("AcceptedBy")
  assignments             VolunteerAssignment[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([status])
  @@index([baseLatitude, baseLongitude])
  @@index([serviceRadiusKm])
}

model Volunteer {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoId              String
  ngo                NGOProfile         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name               String
  status             VolunteerStatus    @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  phoneNumber        String
  city               String?
  operatingArea      String?
  vehicleInfo        String?
  emergencyContact   String?
  rejectionReason    String?
  assignments        VolunteerAssignment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([ngoId])
  @@index([status])
  @@index([verificationStatus])
}

model Donation {
  id                String   @id @default(cuid())
  donorId           String
  donor             DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)
  title             String
  description       String
  foodCategory      String
  vegNonVegMixed    String
  quantity          String
  quantityUnit      String
  estimatedServings Int?
  preparationTime   DateTime?
  pickupAvailableAt DateTime
  pickupDeadlineAt  DateTime
  pickupAddress     String
  pickupLatitude    Float
  pickupLongitude   Float
  specialNotes      String?
  photoUrl          String?
  status            DonationStatus @default(AVAILABLE)
  acceptedNgoId     String?
  acceptedNgo       NGOProfile? @relation("AcceptedBy", fields: [acceptedNgoId], references: [id])
  statusHistory     DonationStatusHistory[]
  assignment        VolunteerAssignment?
  images            DonationImage[]
  audits            FoodListingAudit[]
  organicMission    OrganicRecoveryMission?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?

  @@index([donorId])
  @@index([status])
  @@index([acceptedNgoId])
  @@index([pickupLatitude, pickupLongitude])
  @@index([pickupDeadlineAt])
  @@index([createdAt])
}

model DonationImage {
  id         String @id @default(cuid())
  donationId String
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  imageUrl   String
  uploadedAt DateTime @default(now())
}

model DonationStatusHistory {
  id               String @id @default(cuid())
  donationId       String
  donation         Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  previousStatus   DonationStatus
  newStatus        DonationStatus
  changedBy        String
  changedAt        DateTime @default(now())
  reason           String?
  metadata         String?

  @@index([donationId])
  @@index([changedAt])
}

model VolunteerAssignment {
  id                 String @id @default(cuid())
  donationId         String @unique
  donation           Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  volunteerId        String
  volunteer          Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  ngoId              String
  ngo                NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  status             AssignmentStatus @default(ASSIGNED)
  assignedAt         DateTime @default(now())
  startedAt          DateTime?
  arrivedAt          DateTime?
  pickupConfirmedAt  DateTime?
  deliveryStartedAt  DateTime?
  deliveryConfirmedAt DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  lastLocationUpdate DateTime?
  lastLatitude       Float?
  lastLongitude      Float?
  
  // Secure Handover OTP
  pickupOtpHash      String?
  pickupOtpExpiresAt DateTime?
  pickupOtpAttempts  Int @default(0)

  @@index([volunteerId])
  @@index([ngoId])
  @@index([status])
}

model Notification {
  id                String @id @default(cuid())
  userId            String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  title             String
  message           String
  relatedDonationId String?
  relatedNgoId      String?
  isRead            Boolean @default(false)
  readAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model ImpactRecord {
  id                String @id @default(cuid())
  donationId        String @unique
  foodWeightKg      Float
  estimatedServings Int
  co2EquivalentKg   Float
  waterSavedLiters  Float
  calculationMethod String
  factorsUsed       String
  createdAt         DateTime @default(now())
}

model AuditLog {
  id                String @id @default(cuid())
  userId            String?
  role              String?
  action            String
  entityType        String
  entityId          String?
  previousValues    String?
  newValues         String?
  metadata          String?
  timestamp         DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model FoodListingAudit {
  id                    String    @id @default(cuid())
  donationId            String?
  donation              Donation? @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donorId               String?
  status                String    // "COMPLETED" | "AI_UNAVAILABLE" | "FAILED"
  foodCategory          String?
  estimatedServings     Int?
  estimatedQuantityKg   Float?
  packagingObservation  String?
  visualObservations    Json?     // Stored as JSON array
  warnings              Json?     // Stored as JSON array
  confidence            Float?
  provider              String?
  model                 String?
  createdAt             DateTime  @default(now())

  @@index([donationId])
  @@index([donorId])
}

model OrganicFacility {
  id                 String   @id @default(cuid())
  name               String
  facilityType       String   // "BIOMETHANATION_PLANT", "BIO_CNG_STATION", "COMMUNITY_COMPOSTER", "ANIMAL_FEED_SHELTER"
  operatorName       String
  address            String
  city               String   @default("Pune")
  latitude           Float
  longitude          Float
  contactPhone       String
  contactEmail       String?
  dailyCapacityKg    Float    @default(5000)
  currentLoadKg      Float    @default(0)
  acceptedWasteTypes String   @default("COOKED_FOOD,VEGETABLE_WASTE,BAKERY_EXPIRED,ORGANIC_SLURRY")
  processingMethod   String   // "ANAEROBIC_DIGESTION", "AEROBIC_WINDROW", "THERMOPHILIC_COMPOSTING", "FEED_PROCESSING"
  outputProduct      String   // "BIO_GAS_AND_SLURRY", "RICH_ORGANIC_COMPOST", "CATTLE_FEED", "BIO_CNG"
  isActive           Boolean  @default(true)
  missions           OrganicRecoveryMission[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([city])
  @@index([facilityType])
  @@index([isActive])
}

model OrganicRecoveryMission {
  id                      String          @id @default(cuid())
  donationId              String          @unique
  donation                Donation        @relation(fields: [donationId], references: [id], onDelete: Cascade)
  facilityId              String
  facility                OrganicFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  initiatedById           String
  assignedVolunteerId     String?
  assignedVolunteerName   String?
  vehicleType             String?         @default("Cargo Auto")
  status                  String          @default("DISPATCHED") // "DISPATCHED", "IN_TRANSIT", "ARRIVED_AT_FACILITY", "PROCESSED", "REJECTED"
  divertReason            String?
  foodWeightKg            Float
  wasteCategory           String          @default("MIXED_ORGANIC")
  gateEntryOtp            String?
  gateEntryConfirmedAt    DateTime?
  processingCompletedAt   DateTime?
  cleanEnergyKwh          Float?          // ~1.25 kWh/kg via biomethanation
  biogasM3                Float?          // ~0.25 m3/kg
  bioFertilizerKg         Float?          // ~0.35 kg/kg
  landfillMethaneAvoidedKg Float?         // ~1.9 kg CO2e/kg
  notes                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([facilityId])
  @@index([status])
  @@index([assignedVolunteerId])
  @@index([createdAt])
}

