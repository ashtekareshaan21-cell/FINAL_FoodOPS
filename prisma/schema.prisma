// Prisma schema for FoodOps platform

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// ============ ENUMS ============

enum UserRole {
  DONOR
  NGO
  VOLUNTEER
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  ACCEPTED
  VOLUNTEER_ASSIGNED
  PICKUP_IN_PROGRESS
  PICKED_UP
  DELIVERY_IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
  RECOVERY_ESCALATED
  ORGANIC_RECOVERY
}

enum NGOStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  INACTIVE
}

enum NgoAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  ARRIVED
  COMPLETED
  CANCELLED
}

// ============ USERS & AUTHENTICATION ============

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  phoneNumber       String   @unique
  passwordHash      String?
  role              UserRole @default(DONOR)
  isPhoneVerified   Boolean  @default(false)
  isEmailVerified   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?

  // Relationships
  donor            DonorProfile?
  ngo              NGOProfile?
  volunteer        Volunteer?
  admin            AdminProfile?
  notifications    Notification[]
  otpAttempts      OTPAttempt[]

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
}

model OTPAttempt {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp               String
  purpose           String
  expiresAt         DateTime
  isUsed            Boolean @default(false)
  usedAt            DateTime?
  attemptCount      Int @default(0)
  lastAttemptAt    DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  adminLevel        Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DonorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName  String
  organizationType  String
  contactPerson     String
  address           String
  latitude          Float
  longitude         Float
  donations         Donation[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model NGOProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName       String   @unique
  registrationNumber     String   @unique
  status                 NGOStatus @default(PENDING_VERIFICATION)
  baseAddress            String
  baseLatitude           Float
  baseLongitude          Float
  serviceRadiusKm        Int @default(10)
  availability           NgoAvailability @default(AVAILABLE)
  availabilityUpdatedAt  DateTime @default(now())
  acceptedFoodTypes      String @default("")
  contactPerson          String
  contactPhone           String
  verificationDocumentUrl String?
  verificationSubmittedAt DateTime?
  verificationApprovedAt DateTime?
  verificationRejectedAt DateTime?
  rejectionReason        String?
  volunteers             Volunteer[]
  acceptedDonations      Donation[] @relation("AcceptedBy")
  assignments            VolunteerAssignment[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status])
  @@index([baseLatitude, baseLongitude])
  @@index([serviceRadiusKm])
}

model Volunteer {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoId             String
  ngo               NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  name              String
  status            VolunteerStatus @default(ACTIVE)
  phoneNumber       String
  assignments       VolunteerAssignment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ngoId])
  @@index([status])
}

model Donation {
  id                String   @id @default(cuid())
  donorId           String
  donor             DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)
  title             String
  description       String
  foodCategory      String
  vegNonVegMixed    String
  quantity          String
  quantityUnit      String
  estimatedServings Int?
  preparationTime   DateTime?
  pickupAvailableAt DateTime
  pickupDeadlineAt  DateTime
  pickupAddress     String
  pickupLatitude    Float
  pickupLongitude   Float
  specialNotes      String?
  photoUrl          String?
  status            DonationStatus @default(AVAILABLE)
  acceptedNgoId     String?
  acceptedNgo       NGOProfile? @relation("AcceptedBy", fields: [acceptedNgoId], references: [id])
  statusHistory     DonationStatusHistory[]
  assignment        VolunteerAssignment?
  images            DonationImage[]
  audits            FoodListingAudit[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?

  @@index([donorId])
  @@index([status])
  @@index([acceptedNgoId])
  @@index([pickupLatitude, pickupLongitude])
  @@index([pickupDeadlineAt])
  @@index([createdAt])
}

model DonationImage {
  id         String @id @default(cuid())
  donationId String
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  imageUrl   String
  uploadedAt DateTime @default(now())
}

model DonationStatusHistory {
  id               String @id @default(cuid())
  donationId       String
  donation         Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  previousStatus   DonationStatus
  newStatus        DonationStatus
  changedBy        String
  changedAt        DateTime @default(now())
  reason           String?
  metadata         String?

  @@index([donationId])
  @@index([changedAt])
}

model VolunteerAssignment {
  id                 String @id @default(cuid())
  donationId         String @unique
  donation           Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  volunteerId        String
  volunteer          Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  ngoId              String
  ngo                NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  status             AssignmentStatus @default(ASSIGNED)
  assignedAt         DateTime @default(now())
  startedAt          DateTime?
  arrivedAt          DateTime?
  pickupConfirmedAt  DateTime?
  deliveryStartedAt  DateTime?
  deliveryConfirmedAt DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  lastLocationUpdate DateTime?
  lastLatitude       Float?
  lastLongitude      Float?
  
  // Secure Handover OTP
  pickupOtpHash      String?
  pickupOtpExpiresAt DateTime?
  pickupOtpAttempts  Int @default(0)

  @@index([volunteerId])
  @@index([ngoId])
  @@index([status])
}

model Notification {
  id                String @id @default(cuid())
  userId            String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  title             String
  message           String
  relatedDonationId String?
  relatedNgoId      String?
  isRead            Boolean @default(false)
  readAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model ImpactRecord {
  id                String @id @default(cuid())
  donationId        String @unique
  foodWeightKg      Float
  estimatedServings Int
  co2EquivalentKg   Float
  waterSavedLiters  Float
  calculationMethod String
  factorsUsed       String
  createdAt         DateTime @default(now())
}

model AuditLog {
  id                String @id @default(cuid())
  userId            String?
  role              String?
  action            String
  entityType        String
  entityId          String?
  previousValues    String?
  newValues         String?
  metadata          String?
  timestamp         DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model FoodListingAudit {
  id                    String    @id @default(cuid())
  donationId            String?
  donation              Donation? @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donorId               String?
  status                String    // "COMPLETED" | "AI_UNAVAILABLE" | "FAILED"
  foodCategory          String?
  estimatedServings     Int?
  estimatedQuantityKg   Float?
  packagingObservation  String?
  visualObservations    Json?     // Stored as JSON array
  warnings              Json?     // Stored as JSON array
  confidence            Float?
  provider              String?
  model                 String?
  createdAt             DateTime  @default(now())

  @@index([donationId])
  @@index([donorId])
}

